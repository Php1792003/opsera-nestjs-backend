generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                    String   @id @default(uuid())
  name                  String
  subscriptionPlan      String   @default("STARTER")
  subscriptionExpiresAt DateTime?
  isActive              Boolean  @default(true)
  maxQRCodes            Int      @default(100)
  maxUsers              Int      @default(5)
  maxProjects           Int      @default(1)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  users                 User[]
  projects              Project[]
  roles                 Role[]
  qrcodes               QRCode[]
  tasks                 Task[]
  scanLogs              ScanLog[]
  subscriptions         Subscription[]
  notifications         Notification[]
  locationLogs          LocationLog[]
  files                 File[]
  workflows             Workflow[]
  workflowInstances     WorkflowInstance[]
  workflowApprovals     WorkflowApproval[]
  rateLimitRules        RateLimitRule[]
  rateLimitLogs         RateLimitLog[]
  taskComments          TaskComment[]
  taskAttachments       TaskAttachment[]
  taskTimeEntries       TaskTimeEntry[]
  taskTemplates         TaskTemplate[]
  activityLogs          ActivityLog[]

  @@index([subscriptionPlan])
  @@index([isActive])
}

model User {
  id                    String    @id @default(uuid())
  email                 String    @unique
  password              String
  fullName              String
  isTenantAdmin         Boolean   @default(false)
  isSuperAdmin          Boolean   @default(false)
  status                String    @default("active")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  tenantId              String
  roleId                String?

  tenant                Tenant    @relation(fields: [tenantId], references: [id], onDelete: NoAction)
  role                  Role?     @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  projectMembers       ProjectMember[] @relation("UserToProjectMembers")
  createdTasks          Task[]    @relation("Creator")
  assignedTasks         Task[]    @relation("Assignee")
  scanLogs              ScanLog[]
  notifications         Notification[]
  locationLogs          LocationLog[]
  files                 File[]
  createdWorkflows      Workflow[]
  startedWorkflowInstances WorkflowInstance[]
  assignedWorkflowApprovals WorkflowApproval[] @relation("AssignedTo")
  approvedWorkflowApprovals WorkflowApproval[] @relation("ApprovedBy")
  createdRateLimitRules RateLimitRule[]
  rateLimitLogs         RateLimitLog[]
  taskComments          TaskComment[]
  taskAttachments       TaskAttachment[]
  taskTimeEntries       TaskTimeEntry[]
  createdTaskTemplates  TaskTemplate[]
  activityLogs          ActivityLog[]

  @@index([tenantId])
  @@index([roleId])
  @@index([email])
}

model Role {
  id          String   @id @default(uuid())
  name        String
  permissions String   @db.NVarChar(Max)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenantId    String

  projectId   String?
  
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: NoAction)
  users       User[]

  @@index([tenantId])
  @@index([name])
}

model Project {
  id          String   @id @default(uuid())
  name        String
  description String?  @db.NVarChar(Max)
  address     String?  @db.NVarChar(Max)
  status      String   @default("active")
  image       String?  @db.NVarChar(Max)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenantId    String

  members     ProjectMember[] @relation("ProjectToProjectMembers")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: NoAction)
  qrcodes     QRCode[]
  tasks       Task[]

  @@index([tenantId])
  @@index([name])
}

model ProjectMember {
  userId     String
  user       User     @relation("UserToProjectMembers", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  projectId  String
  project    Project  @relation("ProjectToProjectMembers", fields: [projectId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())
  @@id([userId, projectId])
}
model QRCode {
  id          String   @id @default(uuid())
  name        String
  location    String?
  data        String   @unique @default(cuid())
  isActive    Boolean  @default(true)
  latitude    Float?
  longitude   Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  projectId   String
  tenantId    String

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  scanLogs    ScanLog[]

  @@index([projectId])
  @@index([tenantId])
}

model Task {
  id             String    @id @default(uuid())
  title          String
  description    String?   @db.NVarChar(Max)
  status         String    @default("PENDING")
  priority       String    @default("MEDIUM")
  tags           String?   @db.NVarChar(Max)
  estimatedHours Float?
  actualHours    Float?
  notes          String?   @db.NVarChar(Max)
  deadline       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  projectId      String
  creatorId      String
  assigneeId     String?
  tenantId       String

  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator        User           @relation("Creator", fields: [creatorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assignee       User?          @relation("Assignee", fields: [assigneeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  comments       TaskComment[]
  attachments    TaskAttachment[]
  timeEntries    TaskTimeEntry[]

  @@index([projectId])
  @@index([creatorId])
  @@index([assigneeId])
  @@index([tenantId])
}

model ScanLog {
  id          String   @id @default(cuid())
  scannedAt   DateTime @default(now())
  notes       String?  @db.NVarChar(Max)
  attachments String?  @db.NVarChar(Max)
  
  status      String?
  location    String?  @db.NVarChar(Max)

  qrCodeId    String
  userId      String
  tenantId    String

  qrCode      QRCode   @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([qrCodeId])
  @@index([userId])
}
model Subscription {
  id              String   @id @default(uuid())
  plan            String
  price           Decimal  @db.Decimal(10, 2)
  status          String   @default("ACTIVE")
  startDate       DateTime @default(now())
  endDate         DateTime
  autoRenew       Boolean  @default(true)
  paymentMethod   String?
  lastPaymentDate DateTime?
  nextPaymentDate DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenantId        String

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
}

model MasterAdmin {
  id           String              @id @default(uuid())
  email        String              @unique
  password     String
  fullName     String
  isActive     Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  activityLogs MasterActivityLog[]
}

model MasterActivityLog {
  id            String      @id @default(cuid())
  action        String
  details       String?     @db.NVarChar(Max)
  entity        String?
  entityId      String?
  createdAt     DateTime    @default(now())
  masterAdminId String
  masterAdmin   MasterAdmin @relation(fields: [masterAdminId], references: [id], onDelete: Cascade)

  @@index([masterAdminId])
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String   @db.NVarChar(Max)
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  tenantId  String
  userId    String?

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tenantId])
  @@index([userId])
}

model LocationLog {
  id        String   @id @default(uuid())
  latitude  Float
  longitude Float
  address   String?
  createdAt DateTime @default(now())
  tenantId  String
  userId    String

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: NoAction)
  user      User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tenantId])
  @@index([userId])
}

model File {
  id           String   @id @default(uuid())
  fileName     String
  originalName String
  filePath     String
  mimeType     String
  size         Int
  createdAt    DateTime @default(now())
  tenantId     String
  userId       String

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: NoAction)
  user         User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tenantId])
  @@index([userId])
}

model Workflow {
  id          String             @id @default(uuid())
  name        String
  description String?            @db.NVarChar(Max)
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  tenantId    String
  createdById String

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: NoAction)
  createdBy   User               @relation(fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  steps       WorkflowStep[]
  instances   WorkflowInstance[]

  @@index([tenantId])
  @@index([createdById])
}

model WorkflowStep {
  id         String   @id @default(uuid())
  name       String
  order      Int
  type       String
  config     String?  @db.NVarChar(Max)
  workflowId String

  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
}

model WorkflowInstance {
  id          String             @id @default(uuid())
  status      String             @default("PENDING")
  data        String?            @db.NVarChar(Max)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  workflowId  String
  startedById String
  tenantId    String

  workflow    Workflow           @relation(fields: [workflowId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  startedBy   User               @relation(fields: [startedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approvals   WorkflowApproval[]

  @@index([workflowId])
  @@index([startedById])
  @@index([tenantId])
}

model WorkflowApproval {
  id                 String           @id @default(uuid())
  status             String           @default("PENDING")
  comments           String?          @db.NVarChar(Max)
  approvedAt         DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  workflowInstanceId String
  assignedToId       String
  approvedById       String?
  tenantId           String

  workflowInstance WorkflowInstance @relation(fields: [workflowInstanceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  assignedTo       User             @relation("AssignedTo", fields: [assignedToId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approvedBy       User?            @relation("ApprovedBy", fields: [approvedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([workflowInstanceId])
  @@index([assignedToId])
}

model RateLimitRule {
  id          String       @id @default(uuid())
  name        String
  pattern     String
  method      String?
  limit       Int
  window      Int
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  tenantId    String
  createdById String

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: NoAction)
  createdBy   User         @relation(fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  logs        RateLimitLog[]

  @@index([tenantId])
}

model RateLimitLog {
  id            String        @id @default(uuid())
  ipAddress     String
  userAgent     String?
  requestCount  Int           @default(1)
  windowStart   DateTime
  createdAt     DateTime      @default(now())
  tenantId      String
  userId        String?
  ruleId        String

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user          User?         @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rule          RateLimitRule @relation(fields: [ruleId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenantId])
  @@index([userId])
}

model TaskComment {
  id        String   @id @default(uuid())
  content   String   @db.NVarChar(Max)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  taskId    String
  userId    String
  tenantId  String

  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user      User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([taskId])
  @@index([userId])
}

model TaskAttachment {
  id           String   @id @default(uuid())
  fileName     String
  originalName String
  filePath     String
  mimeType     String
  size         Int
  createdAt    DateTime @default(now())
  taskId       String
  userId       String
  tenantId     String

  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user         User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([taskId])
  @@index([userId])
}

model TaskTimeEntry {
  id          String    @id @default(uuid())
  description String?   @db.NVarChar(Max)
  startTime   DateTime
  endTime     DateTime?
  duration    Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  taskId      String
  userId      String
  tenantId    String

  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user        User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([taskId])
  @@index([userId])
}

model TaskTemplate {
  id          String   @id @default(uuid())
  name        String
  description String?  @db.NVarChar(Max)
  template    String   @db.NVarChar(Max)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenantId    String
  createdById String

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: NoAction)
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tenantId])
}

model ActivityLog {
  id           String   @id @default(cuid())
  action       String
  details      String?  @db.NVarChar(Max)
  entity       String?
  entityId     String?
  createdAt    DateTime @default(now())
  userId       String
  tenantId     String

  user         User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId])
  @@index([tenantId])
}